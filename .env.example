APP_ENV=development
LOG_LEVEL=INFO
MCP_SERVER_NAME=Expense Tracker
TRANSPORT=stdio
HOST=127.0.0.1
PORT=8000
DATABASE_URL=postgresql://expense_user:expense_pass@localhost:5432/expense_db

